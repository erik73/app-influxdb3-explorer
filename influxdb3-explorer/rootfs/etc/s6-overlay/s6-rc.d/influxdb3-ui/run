#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant App: InfluxDB3 Explorer
# Runs the InfluxDB3 UI
# ==============================================================================

bashio::log.info "Configuring environment variables for Explorer"

export SESSION_SECRET_KEY="$(< /data/session_secret)"
export UI_MODE=admin
export INFLUXDB3_UI_DEFAULT_PORT=80
export INFLUXDB3_UI_DEFAULT_DATA_DIR=data/db
export PLUGIN_REGISTRY_ALLOWED_HOSTS=github.com

bashio::log.info "Starting InfluxDB3 Explorer...."

exec /usr/local/bin/influxdb3-ui --log-level $(bashio::config 'influxd_log_level')